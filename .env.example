# Mock mode is explicit and uses the fixed development identity below.
# Production Web must set USE_MOCKS=false and a deployed HTTPS API base URL.
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000
EXPO_PUBLIC_USE_MOCKS=true
EXPO_PUBLIC_CURRENT_USER_ID=user-lili
PORT=4000
# Community Spark uses DeepSeek. DEEPSEEK_API_KEY is server-only.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_COMMUNITY_SPARK_MODEL=deepseek-v4-flash
# Legacy fallback only; new AI deployments should use DEEPSEEK_API_KEY.
OPENAI_API_KEY=
OPENAI_MODEL=
# Vercel Cron automatically sends CRON_SECRET as a bearer token.
CRON_SECRET=
# Optional: authorizes a Supabase Database Webhook to wake the same worker.
INTERNAL_THREAD_VERSION_SECRET=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/linespace
SUPABASE_URL=
# Preferred public server-side key. SUPABASE_ANON_KEY remains a legacy fallback.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Web: https://<web-domain>/auth/confirm; Native: linespace://auth/confirm
AUTH_EMAIL_REDIRECT_URL=http://localhost:8081/auth/confirm
